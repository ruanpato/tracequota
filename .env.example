# Optional: defaults work without this file. Copy to .env to override them.
# Localhost deployment only. See docs/configuration.md for every setting.
# Change passwords before first startup if other local users are untrusted.
# Changing these later does not rotate credentials in existing volumes.
POSTGRES_PASSWORD=tracequota-local
GRAFANA_PASSWORD=tracequota-local
WEB_PORT=8080
GRAFANA_PORT=3000
PHOENIX_PORT=6006
PROMETHEUS_PORT=9090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Disable bundled pricing sync only when using an explicit local sync workflow.
TRACEQUOTA_PRICING_SYNC=true
