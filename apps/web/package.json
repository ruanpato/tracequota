{
  "name": "tracequota-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "prettier": "3.6.2"
  },
  "license": "Apache-2.0",
  "author": "Ruan Pato",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruanpato/tracequota.git"
  }
}
